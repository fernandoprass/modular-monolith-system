meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host.shared}}/api/{{version}}/shared/lookups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "country",
    "parentId": null,
    "organizationId": null,
    "isActive": true,
    "translations": [
      { "languageCode": "en-US", "code": "BR", "value": "Brazil", "description": null, "isActive": true },
      { "languageCode": "pt-BR", "code": "BR", "value": "Brasil", "description": null, "isActive": true }
    ]
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("lookupId", res.body.data.id);
}
