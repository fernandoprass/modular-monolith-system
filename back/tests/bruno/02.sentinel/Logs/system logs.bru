meta {
  name: system logs
  type: http
  seq: 3
}

get {
  url: {{host.sentinel}}/api/{{version}}/sentinel/logs/system?pageNumber=1&pageSize=50
  body: none
  auth: bearer
}

params:query {
  pageNumber: 1
  pageSize: 50
  ~organizationId: {{organizationId}}
  ~userId: {{userId}}
  ~level: 
  ~status: 
  ~requestId: 
  ~from: 
  ~to: 
}

auth:bearer {
  token: {{token}}
}
