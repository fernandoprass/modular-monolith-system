meta {
  name: system logs
  type: http
  seq: 3
}

get {
  url: {{host.sentinel}}/api/{{version}}/sentinel/logs/system
  body: none
  auth: bearer
}

params:query {
  ~organizationId: {{organizationId}}
  ~userId: {{userId}}
  ~level:
  ~status:
  ~source:
  ~requestId:
  ~from:
  ~to:
  pageNumber: 1
  pageSize: 50
}

auth:bearer {
  token: {{token}}
}
