meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host.iam}}/api/{{version}}/iam/organizations/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": 1,
    "name": "Writer Society",
    "code": "Writer4",
    "description": "The greatest writers of all time",
    "defaultLanguage": "pt-BR",
    "user": {
      "name": "Mario Puzo",
      "email": "mario.puzzo4@goodfather.it",
      "password": "Password.1",
      "language": "en"
    }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.data) {
      bru.setVar("organizationId", body.data.id);
    }
  }
}
