meta {
  name: search by params
  type: http
  seq: 4
}

get {
  url: {{host.iam}}/api/{{version}}/iam/permissions?includeInactive=true&title&pageNumber=1&pageSize=25
  body: none
  auth: bearer
}

params:query {
  includeInactive: true
  title: 
  pageNumber: 1
  pageSize: 25
  ~roleId: {{roleId}}
  ~module: iam
  ~resource: users
  ~action: view
}

auth:bearer {
  token: {{token}}
}
