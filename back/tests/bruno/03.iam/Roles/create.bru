meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host.iam}}/api/{{version}}/iam/roles/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "RoleName Active",
    "description": "Api test",
    "isDefault": true,
    "isActive": true,
    "organizationId": "{{organizationId}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.data) {
      bru.setVar("roleId", body.data.id);
    }
  }
}
