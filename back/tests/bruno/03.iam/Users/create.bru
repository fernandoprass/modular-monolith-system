meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host.iam}}/api/{{version}}/iam/users/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Paul",
    "email": "paul5@beatles.com",
    "password": "Beatle@4",
    "organizationId": "{{organizationId}}",
    "language": "en"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.data) {
      bru.setVar("userId", body.data.id);
    }
  }
}
