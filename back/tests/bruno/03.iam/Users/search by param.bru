meta {
  name: search by param
  type: http
  seq: 10
}

get {
  url: {{host.iam}}/api/{{version}}/iam/users/?pageNumber=1&pageSize=25
  body: none
  auth: bearer
}

params:query {
  pageNumber: 1
  pageSize: 25
  ~name: ala
  ~email: 
  ~organizationId: {{organizationId}}
  ~isActive: false
}

auth:bearer {
  token: {{token}}
}
