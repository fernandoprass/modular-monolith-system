meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{host.courier}}/api/{{version}}/templates/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "module": "iam",
    "key": "user-welcome",
    "isAllowingOptOut": false,
    "severity": 1,
    "retentionPolicy": 1
  }
}
