meta {
  name: search by params
  type: http
  seq: 2
}

get {
  url: {{host.courier}}/api/{{version}}/templates?severity=1&pageNumber=1
  body: none
  auth: bearer
}

params:query {
  severity: 1
  pageNumber: 1
  ~pageSize: 25
  ~module: iam
  ~key: res
  ~name: welcome
}

auth:bearer {
  token: {{token}}
}
