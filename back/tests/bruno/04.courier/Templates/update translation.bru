meta {
  name: update translation
  type: http
  seq: 6
}

put {
  url: {{host.courier}}/api/{{version}}/templates/{{templateId}}/translations/{{language}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "language": "pt-BR",
    "name": "User welcome",
    "email": {
      "subject": "Bem-vindo ao sistema, {{user.name}}",
      "body": "<p>Sua conta está pronta.</p>"
    },
    "notification": {
      "title": "Conta pronta!",
      "message": "Acesse seu perfil para começar.",
      "actionLink": "/perfil"
    }
  }
}

vars:pre-request {
  language: pt-BR
}
