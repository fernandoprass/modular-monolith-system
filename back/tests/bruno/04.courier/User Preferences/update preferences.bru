meta {
  name: update preferences
  type: http
  seq: 3
}

put {
  url: {{host.courier}}/api/{{version}}/user-preferences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "templates": [
      {
        "module": "iam",
        "key": "user-welcome",
        "isEmailEnabled": true,
        "isNotificationEnabled": false
      }
    ]
  }
}
