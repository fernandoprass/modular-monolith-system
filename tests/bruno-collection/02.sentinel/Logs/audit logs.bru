meta {
  name: audit logs
  type: http
  seq: 1
}

get {
  url: {{host.sentinel}}/api/{{version}}/sentinel/logs/audit
  body: none
  auth: bearer
}

params:query {
  ~organizationId: {{organizationId}}
  ~userId: {{userId}}
  ~module:
  ~feature:
  ~action:
  ~privacyLevel:
  ~targetId:
  ~from:
  ~to:
  pageNumber: 1
  pageSize: 50
}

auth:bearer {
  token: {{token}}
}
