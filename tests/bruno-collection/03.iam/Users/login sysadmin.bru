meta {
  name: login sysadmin
  type: http
  seq: 4
}

post {
  url: {{host.iam}}/api/{{version}}/iam/users/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@saas.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && body.data && body.data.token) {
      bru.setEnvVar("token", body.data.token);
      bru.setEnvVar("organizationId", body.data.user.organizationId);
      bru.setVar("loggedUserId", body.data.user.id);
    }
  }
}
