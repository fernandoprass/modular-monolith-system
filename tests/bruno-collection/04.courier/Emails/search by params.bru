meta {
  name: search by params
  type: http
  seq: 2
}

get {
  url: {{host.courier}}/api/{{version}}/emails
  body: none
  auth: bearer
}

params:query {
  ~organizationId: {{organizationId}}
  ~userId: {{userId}}
  ~module: IAM
  ~feature: users
  ~subject:
  ~recipient:
  ~dateFrom:
  ~dateTo:
  pageNumber: 1
  pageSize: 25
}

auth:bearer {
  token: {{token}}
}
