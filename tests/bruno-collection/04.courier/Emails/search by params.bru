meta {
  name: search by params
  type: http
  seq: 2
}

get {
  url: {{host.courier}}/api/{{version}}/emails?pageNumber=1&pageSize=25
  body: none
  auth: bearer
}

params:query {
  pageNumber: 1
  pageSize: 25
  ~organizationId: {{organizationId}}
  ~userId: {{userId}}
  ~module: IAM
  ~feature: users
  ~subject: 
  ~recipient: 
  ~dateFrom: 
  ~dateTo: 
}

auth:bearer {
  token: {{token}}
}
